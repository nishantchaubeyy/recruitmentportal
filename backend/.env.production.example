# Production Environment Variables for DYPIU Recruitment Portal Backend
# File path on server: backend/.env

PORT=5000
NODE_ENV=production

# PostgreSQL Database Connection String
DATABASE_URL="postgresql://dypiu_user:YourStrongPassword@localhost:5432/dypiu_recruitment?schema=public"

# Security & Authentication Secrets (Generate long random strings)
JWT_SECRET="dypiu-recruitment-jwt-production-secret-key-2026"
REFRESH_SECRET="dypiu-recruitment-refresh-production-secret-key-2026"

# Allowed CORS Origin (Server IP)
CORS_ORIGIN="http://10.100.0.37"

# Upload Directory Path
UPLOAD_DIR="/var/www/recruitment-portal/uploads"
