# Production Environment Variables for DYPIU Recruitment Portal Backend
# File path on server: backend/.env

PORT=5000
NODE_ENV=production

# PostgreSQL Database Connection String
DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@localhost:5432/<DB_NAME>?schema=public"

# Security & Authentication Secrets
JWT_SECRET="<CHANGE_ME_RANDOM_SECRET>"
REFRESH_SECRET="<CHANGE_ME_REFRESH_SECRET>"

# Allowed CORS Origin (Intranet Server)
CORS_ORIGIN="https://intranet.dypiu.ac.in"

# Upload Directory Path
UPLOAD_DIR="/var/www/recruitment-portal/uploads"
