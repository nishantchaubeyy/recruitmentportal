NODE_ENV=production
PORT=5000

DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@localhost:5432/<DB_NAME>?schema=public

JWT_SECRET=<GENERATE_STRONG_RANDOM_SECRET>
REFRESH_SECRET=<GENERATE_STRONG_RANDOM_SECRET>

CORS_ORIGIN=https://intranet.dypiu.ac.in

UPLOAD_DIR=/var/lib/dypiu-recruitment/uploads

# Mail Configuration (ZeptoMail REST API or SMTP)
ZEPTOMAIL_API_URL=https://api.zeptomail.in/v1.1/email
ZEPTOMAIL_TOKEN=<CHANGE_ME_ZEPTO_TOKEN>
ZEPTOMAIL_FROM_EMAIL=careers@dypiu.ac.in
ZEPTOMAIL_FROM_NAME="Recruitment Cell - D Y Patil International University"

# Standard SMTP Fallback (optional)
SMTP_HOST=smtp.zeptomail.in
SMTP_PORT=587
SMTP_USER=emailapikey
SMTP_PASS=<CHANGE_ME_SMTP_PASSWORD>
EMAIL_FROM="DYPIU Recruitment Cell <careers@dypiu.ac.in>"

# Audit log signing secret (keep it stable; rotating it makes older audit records unverifiable)
AUDIT_SECRET=<CHANGE_ME_LONG_RANDOM_STRING>
# Number of reverse proxies in front of the app (nginx = 1); makes rate limits and the audit log see the real client IP
TRUST_PROXY=1
