# Server & Environment Configuration
PORT=5000
NODE_ENV=development

# Development
# CORS_ORIGIN=http://localhost:5173

# Production
CORS_ORIGIN=https://intranet.dypiu.ac.in

# PostgreSQL Database Connection
DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@localhost:5432/dypiu_recruitment?schema=public"

# JWT Authentication Secrets
JWT_SECRET="<CHANGE_ME_RANDOM_SECRET>"
REFRESH_SECRET="<CHANGE_ME_REFRESH_SECRET>"

# Storage Upload Directory
UPLOAD_DIR="uploads"

# ZeptoMail Configuration (Recommended: REST API or SMTP)
# 1. ZeptoMail REST API (Uses token starting with 'Zoho-enczapikey')
ZEPTOMAIL_API_URL="https://api.zeptomail.in/v1.1/email"
ZEPTOMAIL_TOKEN="<CHANGE_ME_ZEPTO_TOKEN>"
ZEPTOMAIL_FROM_EMAIL="careers@dypiu.ac.in"
ZEPTOMAIL_FROM_NAME="Recruitment Cell - D Y Patil International University"

# 2. ZeptoMail SMTP Configuration (Alternative to REST API)
ZEPTOMAIL_HOST="smtp.zeptomail.in"
ZEPTOMAIL_PORT=587
ZEPTOMAIL_USERNAME="emailapikey"
ZEPTOMAIL_PASSWORD="<CHANGE_ME_ZEPTO_PASSWORD>"

# Standard SMTP Fallback (e.g. Gmail / College SMTP)
SMTP_HOST="smtp.zeptomail.in"
SMTP_PORT=587
SMTP_USER="emailapikey"
SMTP_PASS="<CHANGE_ME_SMTP_PASSWORD>"
EMAIL_FROM='"DYPIU Recruitment Cell" <careers@dypiu.ac.in>'

# Seed Default Credentials Configuration
SEED_ADMIN_EMAIL="admin@dypiu.edu"
SEED_ADMIN_PASSWORD="<CHANGE_ME_ADMIN_PASSWORD>"
SEED_APPLICANT_EMAIL="demo@applicant.com"
SEED_APPLICANT_PASSWORD="<CHANGE_ME_APPLICANT_PASSWORD>"
