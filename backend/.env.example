# Server & Environment Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=*

# PostgreSQL Database Connection
DATABASE_URL="postgresql://username:password@localhost:5432/dypiu_recruitment?schema=public"

# JWT Authentication Secrets
JWT_SECRET="your_jwt_access_secret_key"
REFRESH_SECRET="your_jwt_refresh_secret_key"

# Storage Upload Directory
UPLOAD_DIR="uploads"

# SMTP Email Transport Settings
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="careers@dypiu.ac.in"
SMTP_PASS="your_smtp_app_password"
EMAIL_FROM='"DYPIU Recruitment Cell" <careers@dypiu.ac.in>'

# Seed Default Credentials Configuration
SEED_ADMIN_EMAIL="admin@dypiu.edu"
SEED_ADMIN_PASSWORD="AdminPassword123"
SEED_APPLICANT_EMAIL="demo@applicant.com"
SEED_APPLICANT_PASSWORD="Demo@1234"
