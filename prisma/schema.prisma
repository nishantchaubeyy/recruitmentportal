datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      String   @default("APPLICANT") // SUPER_ADMIN, HR_ADMIN, HR_USER, COMMITTEE_MEMBER, APPLICANT, ADMIN
  status    String   @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applicant         Applicant?
  admin             Admin?
  notifications     Notification[]
  auditLogs         AuditLog[]
  interviewsCreated Interview[]          @relation("CreatedInterviews")
  evaluations       Evaluation[]
  vacanciesCreated  Job[]            @relation("CreatedVacancies")
  docRequestsCreated DocumentRequest[] @relation("DocumentRequestsRequestedBy")
  docsVerified       CandidateDocument[] @relation("CandidateDocsVerifiedBy")

  @@index([email])
  @@index([role])
}

model Applicant {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  mobile    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications        Application[]
  interviews          Interview[]
  interviewCandidates InterviewCandidate[]
  documentRequests    DocumentRequest[]
  candidateDocuments  CandidateDocument[]
}

model Admin {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model School {
  id        String   @id @default(uuid())
  name      String   @unique
  type      String   // TEACHING, NON_TEACHING
  faculty   String?  // Faculty e.g. Faculty of Engineering & Technology
  code      String?
  bannerUrl String?
  posterUrl String?
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departments       Department[]
  jobs              Job[]
  vacancyInterests  VacancyInterest[]
}

model Department {
  id        String   @id @default(uuid())
  name      String
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  positions        Position[]
  programs         Program[]
  jobs             Job[]
  vacancyInterests VacancyInterest[]

  @@unique([name, schoolId])
}

model Program {
  id           String     @id @default(uuid())
  name         String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([name, departmentId])
}

model Position {
  id           String     @id @default(uuid())
  title        String
  category     String     // TEACHING, NON_TEACHING
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  jobs             Job[]
  vacancyInterests VacancyInterest[]
}

model Job {
  id                  String      @id @default(uuid())
  vacancyNumber       String      @unique // e.g. VAC-2026-001 format
  position            String
  type                String      // TEACHING, NON_TEACHING
  department          String      // Department / School / Institute text display
  schoolId            String?
  school              School?     @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  departmentId        String?
  departmentRef       Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  positionId          String?
  positionRef         Position?   @relation(fields: [positionId], references: [id], onDelete: SetNull)
  employmentType      String      @default("Full Time")
  numPositions        Int         @default(1)
  qualification       String
  experience          String
  skills              String
  description         String
  salaryScale         String
  location            String      @default("Pune")
  openingDate         DateTime    @default(now())
  deadline            DateTime
  requiredDocuments   String
  eligibilityCriteria String
  bannerUrl           String?
  posterUrl           String?
  imageUrl            String?
  customCategory      String?     // e.g. "Visiting Faculty", "Project Fellow", "Internship"
  customLabel         String?     // display name for the type badge
  status              String      @default("DRAFT") // DRAFT, PUBLISHED, CLOSED, ARCHIVED
  createdBy           String?
  createdByUser       User?       @relation("CreatedVacancies", fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  applications        Application[]
  interviews          Interview[]

  @@index([type])
  @@index([department])
  @@index([status])
  @@index([deadline])
  @@index([createdAt])
}

model VacancyInterest {
  id                 String      @id @default(uuid())
  name               String
  email              String
  mobile             String
  schoolId           String?
  school             School?     @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  departmentId       String?
  department         Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  interestedPosition String
  positionId         String?
  position           Position?   @relation(fields: [positionId], references: [id], onDelete: SetNull)
  category           String      // TEACHING, NON_TEACHING
  message            String?
  status             String      @default("PENDING") // PENDING, NOTIFIED
  notifiedAt         DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([email])
  @@index([category])
  @@index([status])
}

model Application {
  id                String        @id @default(uuid())
  applicationNumber String        @unique // DYPIU-YYYY-XXXXXX format (older rows may still be APP-YYYY-XXXXXX)
  applicantId       String
  applicant         Applicant     @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  jobId             String
  job               Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  schoolId          String?
  departmentId      String?
  status            String        @default("DRAFT") // DRAFT, SUBMITTED, UNDER_REVIEW, SHORTLISTED, etc.
  currentStep       Int           @default(1)
  completionPercentage Int        @default(0)
  emailVerified     Boolean       @default(false)
  confirmationEmailSent   Boolean   @default(false)
  confirmationEmailSentAt DateTime?
  screeningRemarks  String?
  submittedAt       DateTime?
  
  // JSON Section data stored as text/JSON strings
  personalInfo       String?
  contactDetails     String?
  qualifications     String?
  experience         String?
  researchDetails    String?
  skillsCertificates String?
  references         String?
  declaration        Boolean       @default(false)
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  documents         ApplicationDocument[]
  statusHistory     ApplicationStatusHistory[]
  interviews        Interview[]
  interviewCandidates InterviewCandidate[]
  documentRequests  DocumentRequest[]

  @@index([applicationNumber])
  @@index([applicantId])
  @@index([jobId])
  @@index([status])
  @@index([createdAt])
}

model ApplicationDocument {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  documentType  String      // resume, qualification, experience, research, other
  filePath      String      // Storage key/path
  originalName  String
  fileSize      Int
  mimeType      String
  uploadedAt    DateTime    @default(now())

  @@index([applicationId])
  @@index([documentType])
}

model ApplicationStatusHistory {
  id              String      @id @default(uuid())
  applicationId   String
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  previousStatus  String
  newStatus       String
  changedByUserId String
  comment         String?
  changedAt       DateTime    @default(now())

  @@index([applicationId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}

model Interview {
  id                 String              @id @default(uuid())
  title              String?
  applicationId      String?
  application        Application?        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  jobId              String
  job                Job                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId        String?
  candidate          Applicant?          @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  panelId            String?
  panel              InterviewPanel?     @relation(fields: [panelId], references: [id], onDelete: SetNull)
  scheduledAt        DateTime?
  durationMinutes    Int                 @default(30)
  date               DateTime            @default(now())
  time               String              @default("10:00 AM")
  startTime          String?
  endTime            String?
  mode               String              @default("ZOOM")
  venue              String?
  meetingLink        String?
  zoomLink           String?
  zoomJoinUrl        String?
  zoomStartUrl       String?
  zoomMeetingId      String?
  zoomPassword       String?
  interviewerName    String?
  interviewType      String?             @default("Technical")
  notes              String?
  round              String              @default("Round 1")
  status             String              @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED, RESCHEDULED
  cancellationReason String?
  emailSent          Boolean             @default(false)
  emailSentAt        DateTime?
  emailStatus        String              @default("PENDING") // PENDING, SENT, FAILED
  createdById        String?
  createdByUser      User?               @relation("CreatedInterviews", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  selectedMembers    InterviewPanelist[]
  evaluations        Evaluation[]
  candidates         InterviewCandidate[]

  @@index([applicationId])
  @@index([candidateId])
  @@index([jobId])
  @@index([panelId])
  @@index([date])
}

model InterviewPanel {
  id          String         @id @default(uuid())
  name        String         // "Panel A" | "Panel B" | "Panel C" (or custom)
  code        String         @unique // "A" | "B" | "C"
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  members     PanelMember[]
  interviews  Interview[]
}

model PanelMember {
  id                   String              @id @default(uuid())
  panelId              String
  name                 String
  email                String
  phone                String?
  designation          String?
  isActive             Boolean             @default(true)
  panel                InterviewPanel      @relation(fields: [panelId], references: [id], onDelete: Cascade)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  interviewAssignments InterviewPanelist[]

  @@unique([panelId, email])
}

model InterviewPanelist {
  id          String      @id @default(uuid())
  interviewId String
  memberId    String
  interview   Interview   @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  member      PanelMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([interviewId, memberId])
}

model Evaluation {
  id                String    @id @default(uuid())
  interviewId       String
  interview         Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  evaluatorId       String
  evaluator         User      @relation(fields: [evaluatorId], references: [id], onDelete: Cascade)
  communication     Int       @default(0)
  technicalScore    Int       @default(0)
  experienceScore   Int       @default(0)
  domainScore       Int       @default(0)
  totalScore        Float     @default(0)
  recommendation    String    @default("RECOMMEND")
  remarks           String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([interviewId, evaluatorId])
  @@index([interviewId])
  @@index([evaluatorId])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entity     String
  entityId   String
  oldValue   String?
  newValue   String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
}

model InterviewCandidate {
  id               String       @id @default(uuid())
  interviewId      String
  interview        Interview    @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  candidateId      String
  candidate        Applicant    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  applicationId    String?
  application      Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  emailSent        Boolean      @default(false)
  emailSentAt      DateTime?
  emailStatus      String       @default("PENDING") // PENDING, SENT, FAILED
  attendanceStatus String       @default("PENDING") // PENDING, ATTENDED, ABSENT
  feedback         String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([interviewId, candidateId])
  @@index([interviewId])
  @@index([candidateId])
  @@index([applicationId])
}

model DocumentRequest {
  id            String                @id @default(uuid())
  candidateId   String
  candidate     Applicant             @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  applicationId String?
  application   Application?          @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  requestedById String?
  requestedBy   User?                 @relation("DocumentRequestsRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  deadline      DateTime
  priority      String                @default("NORMAL") // NORMAL, URGENT
  message       String?
  status        String                @default("PENDING") // PENDING, PARTIALLY_UPLOADED, SUBMITTED, VERIFIED, REJECTED
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  items         DocumentRequestItem[]

  @@index([candidateId])
  @@index([applicationId])
  @@index([status])
  @@index([deadline])
}

model DocumentRequestItem {
  id                String              @id @default(uuid())
  documentRequestId String
  documentRequest   DocumentRequest     @relation(fields: [documentRequestId], references: [id], onDelete: Cascade)
  documentName      String
  documentType      String              @default("CUSTOM")
  isMandatory       Boolean             @default(true)
  status            String              @default("PENDING") // PENDING, UPLOADED, UNDER_REVIEW, VERIFIED, REJECTED
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  documents         CandidateDocument[]

  @@index([documentRequestId])
  @@index([status])
}

model CandidateDocument {
  id                    String              @id @default(uuid())
  documentRequestItemId String
  documentRequestItem   DocumentRequestItem @relation(fields: [documentRequestItemId], references: [id], onDelete: Cascade)
  candidateId           String
  candidate             Applicant           @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  filePath              String
  fileName              String
  fileType              String
  fileSize              Int
  uploadDate            DateTime            @default(now())
  verificationStatus    String              @default("UNDER_REVIEW") // UNDER_REVIEW, VERIFIED, REJECTED
  verifiedById          String?
  verifiedBy            User?               @relation("CandidateDocsVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt            DateTime?
  rejectionReason       String?
  version               Int                 @default(1)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([documentRequestItemId])
  @@index([candidateId])
  @@index([verificationStatus])
}

/// Every outgoing e-mail attempt (status updates, interviews, documents ...) so HR can see what
/// was delivered, what failed and what was skipped because no mail provider is configured.
model EmailLog {
  id         String   @id @default(uuid())
  toEmail    String
  subject    String
  kind       String   @default("GENERAL") // APPLICATION_STATUS, INTERVIEW, DOCUMENT_REQUEST, OTP, SUBMISSION, GENERAL
  status     String   // SENT, FAILED, SKIPPED
  provider   String?  // zeptomail-api, smtp, none
  error      String?
  entityType String?
  entityId   String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([status])
  @@index([createdAt])
}
