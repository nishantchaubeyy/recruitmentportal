# NOTE: This configuration is for STANDALONE domain/root hosting.
# For sub-path deployment under /recruitment/ on an existing server, see SUBPATH_DEPLOYMENT.md.

server {
    listen 80;
    server_name <YOUR_SERVER_IP_OR_DOMAIN>;

    # Client upload size limit (allows PDF dossier, large poster uploads up to 50MB)
    client_max_body_size 50M;

    # 1. Frontend Static Files (Vite SPA)
    root /var/www/recruitment-portal/html;
    index index.html;

    # Gzip Compression
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;
    gzip_proxied any;

    # Frontend SPA Router Handling (routes all non-file paths to index.html)
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 2. Uploaded Media / Posters Direct Serving
    location /uploads/ {
        alias /var/lib/dypiu-recruitment/uploads/;
        expires 30d;
        add_header Cache-Control "public, no-transform";
        try_files $uri @backend;
    }

    # 3. Backend Express API Proxy
    location /api/ {
        proxy_pass http://127.0.0.1:5000/api/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }

    # 4. Fallback Backend Proxy (Named location must NOT contain trailing URI path)
    location @backend {
        proxy_pass http://127.0.0.1:5000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Custom Error Pages
    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
}
